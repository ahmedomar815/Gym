
@model IReadOnlyList<BookingListItemViewModel>

<div class="container py-5">
    <partial name="_TempDataAlert" />
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 text-primary-color mb-1">Bookings</h1>
            <p class="text-muted mb-0">Keep track of members registered for training sessions.</p>
        </div>
        <a asp-action="Create" class="btn btn-fill rounded-pill px-4 py-2">
            <i class="bi bi-calendar-plus me-2"></i>New Booking
        </a>
    </header>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Member</th>
                            <th>Session</th>
                            <th>Trainer</th>
                            <th>Date & time</th>
                            <th class="pe-4">Ends</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@booking.MemberName</td>
                                <td>@booking.SessionName</td>
                                <td>@booking.TrainerName</td>
                                <td>@booking.StartTime.ToString("ddd, dd MMM yyyy · h:mm tt")</td>
                                <td class="pe-4 text-muted">@booking.EndTime.ToString("h:mm tt")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <i class="bi bi-calendar-x display-5 text-muted"></i>
            <h2 class="h4 mt-3">No bookings yet</h2>
            <p class="text-muted">Add a member to an upcoming training session.</p>
            <a asp-action="Create" class="btn btn-fill rounded-pill px-4">Create booking</a>
        </div>
    }
</div>
