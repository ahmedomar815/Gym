@model IReadOnlyList<Gym.Presentation.ViewModels.Trainers.TrainerListItemViewModel>
<div class="container py-5">
    <partial name="_TempDataAlert" />
    <header class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2 text-primary-color mb-1">Trainers</h1><p class="text-muted mb-0">Manage your coaching team.</p></div><a asp-action="Create" class="btn btn-fill"><i class="bi bi-plus-lg me-1"></i>Add trainer</a></header>
    @if (Model.Any()) { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Speciality</th><th>Category</th><th></th></tr></thead><tbody>@foreach (var trainer in Model) { <tr><td class="fw-semibold">@trainer.Name</td><td>@trainer.Email</td><td>@trainer.PhoneNumber</td><td>@trainer.Speciality</td><td>@trainer.CategoryName</td><td class="text-end"><a asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-outline btn-sm me-2">Edit</a><form asp-action="Delete" asp-route-id="@trainer.Id" method="post" class="d-inline"><button class="btn btn-danger btn-sm" onclick="return confirm('Delete @trainer.Name?');">Delete</button></form></td></tr>}</tbody></table></div> } else { <div class="text-center py-5 text-muted"><i class="bi bi-person-workspace display-1"></i><h4 class="mt-3">No trainers available</h4></div> }
</div>
