
@model CreateMemberViewModel

<div class="container">
    <main role="main" class="pb-3">

        <header class="mb-4">
            <h3 class="text-primary-color">Add Member</h3>
        </header>

        <partial name="_TempDataAlert" />

        <form asp-action="Create" method="post">

            

            <table class="table table-bordered align-middle">

                <tbody>

                   
                    <tr>
                        <th colspan="2" class="table-primary">
                            Personal Information
                        </th>
                    </tr>

                    <tr>
                        <th style="width: 30%;">Name</th>
                        <td>
                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter member name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Email</th>
                        <td>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Phone</th>
                        <td>
                            <input asp-for="Phone"
                                   type="tel"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Date Of Birth</th>
                        <td>
                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Gender</th>
                        <td>
                            <select asp-for="Gender"
                                    asp-items="Html.GetEnumSelectList<Gender>()"
                                    class="form-select">

                                <option value="">
                                    -- Select Gender --
                                </option>

                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>


                   

                    <tr>
                        <th colspan="2" class="table-primary">
                            Address Information
                        </th>
                    </tr>

                    <tr>
                        <th>Building Number</th>
                        <td>
                            <input asp-for="BuildingNumber"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter building number" />

                            <span asp-validation-for="BuildingNumber"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Street</th>
                        <td>
                            <input asp-for="Street"
                                   class="form-control"
                                   placeholder="Enter street" />

                            <span asp-validation-for="Street"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>City</th>
                        <td>
                            <input asp-for="City"
                                   class="form-control"
                                   placeholder="Enter city" />

                            <span asp-validation-for="City"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>


                   
                    <tr>
                        <th colspan="2" class="table-primary">
                            Health Information
                        </th>
                    </tr>

                    <tr>
                        <th>Height</th>
                        <td>
                            <input asp-for="HealthRecordViewModel.Height"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Enter height" />

                            <span asp-validation-for="HealthRecordViewModel.Height"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Weight</th>
                        <td>
                            <input asp-for="HealthRecordViewModel.Weight"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Enter weight" />

                            <span asp-validation-for="HealthRecordViewModel.Weight"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Blood Type</th>
                        <td>
                            <select asp-for="HealthRecordViewModel.BloodType"
                                    asp-items="Html.GetEnumSelectList<BloodType>()"
                                    class="form-select">

                                <option value="">
                                    -- Select Blood Type --
                                </option>

                            </select>

                            <span asp-validation-for="HealthRecordViewModel.BloodType"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                    <tr>
                        <th>Note</th>
                        <td>
                            <textarea asp-for="HealthRecordViewModel.Note"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter any health notes"></textarea>

                            <span asp-validation-for="HealthRecordViewModel.Note"
                                  class="text-danger">
                            </span>
                        </td>
                    </tr>

                </tbody>

            </table>


            

            <div class="d-flex justify-content-end gap-3 mt-4">

                <a asp-controller="Member"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    <i class="bi bi-arrow-left me-2"></i>
                    Back to List

                </a>

                <button type="submit"
                        class="btn btn-primary px-4">

                    <i class="bi bi-plus-circle me-2"></i>
                    Add

                </button>

            </div>

        </form>

    </main>
</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertDismissScript" />

}
