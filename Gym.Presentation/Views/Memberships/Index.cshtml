@model IReadOnlyList<Gym.Presentation.ViewModels.Memberships.MembershipListItemViewModel>

<div class="container mt-5">
    <partial name="_TempDataAlert" />

    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary-color mb-1">Memberships</h2>
            <p class="text-muted mb-0">Review every member's plan and subscription status.</p>
        </div>
        <a asp-action="Create" class="btn btn-fill">
            <i class="bi bi-plus-lg me-1"></i>Create membership
        </a>
    </header>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-borderless align-middle">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Plan</th>
                        <th>Start date</th>
                        <th>End date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var membership in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@membership.MemberName</td>
                            <td>@membership.PlanName</td>
                            <td>@membership.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@membership.EndDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge rounded-pill @(membership.IsActive ? "bg-success" : "bg-secondary")">
                                    @(membership.IsActive ? "Active" : "Expired")
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Members" asp-action="MemberDetails" asp-route-id="@membership.MemberId" class="btn btn-outline btn-sm">
                                    <i class="bi bi-eye me-1"></i>View member
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-card-checklist display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Memberships Available</h4>
            <p class="text-muted">Memberships will appear here once they are assigned to members.</p>
        </div>
    }
</div>
