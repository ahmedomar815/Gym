@model Gym.Presentation.ViewModels.Memberships.CreateMembershipViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <h1 class="h3 text-primary-color mb-1">Create membership</h1>
                        <p class="text-muted mb-0">Assign an active membership plan to a member.</p>
                    </div>

                    @if (!Model.Members.Any() || !Model.Plans.Any())
                    {
                        <div class="alert alert-warning mb-4">
                            A membership needs at least one member and one active plan.
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="MemberId" class="form-label"></label>
                            <select asp-for="MemberId" asp-items="Model.Members" class="form-select">
                                <option value="0">Select a member</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PlanId" class="form-label"></label>
                            <select asp-for="PlanId" asp-items="Model.Plans" class="form-select">
                                <option value="0">Select a plan</option>
                            </select>
                            <span asp-validation-for="PlanId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                            <div class="form-text">The end date is calculated from the selected plan's duration.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline flex-fill">Cancel</a>
                            <button type="submit" class="btn btn-fill flex-fill" disabled="@(!Model.Members.Any() || !Model.Plans.Any())">
                                <i class="bi bi-check-lg me-1"></i>Create membership
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
