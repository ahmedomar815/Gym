
@model CreateSessionViewModel

<div class="container">
    <main role="main" class="pb-3">
        <header class="mb-4">
            <h3 class="text-primary-color">Create Session</h3>
        </header>
        
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrainerId" class="form-label"></label>
                <select asp-for="TrainerId" class="form-select">
                    <option value="0">-- Select trainer --</option>
                </select>
                <span asp-validation-for="TrainerId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="0">-- Select category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const categorySelect = document.getElementById('CategoryId');
            const trainerSelect = document.getElementById('TrainerId');
            const trainersUrl = '@Url.Action("GetTrainersByCategory", "Sessions")';
            const selectedTrainerId = '@Model.TrainerId';

            if (!categorySelect || !trainerSelect) return;

            function clearTrainerOptions() {
                trainerSelect.innerHTML = '';
                trainerSelect.add(new Option('-- Select trainer --', '0'));
            }

            async function loadTrainers(categoryId) {
                clearTrainerOptions();

                if (!categoryId || categoryId === '0') return;

                try {
                    const response = await fetch(`${trainersUrl}?categoryId=${encodeURIComponent(categoryId)}`);
                    if (!response.ok) throw new Error('Unable to load trainers.');

                    const trainers = await response.json();
                    trainers.forEach(trainer => {
                        const option = new Option(trainer.name, trainer.id);
                        option.selected = String(trainer.id) === selectedTrainerId;
                        trainerSelect.add(option);
                    });
                } catch (error) {
                    console.error(error);
                }
            }

            categorySelect.addEventListener('change', () => loadTrainers(categorySelect.value));
            loadTrainers(categorySelect.value);
        })();
    </script>
}
