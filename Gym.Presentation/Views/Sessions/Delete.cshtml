@model DeleteSessionViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="bi bi-exclamation-triangle display-5"></i>
                    <h2 class="mt-2 mb-0">Delete Session</h2>
                </div>

                <div class="card-body p-4">
                    <p class="fs-5">Are you sure you want to delete this session?</p>

                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> This action cannot be undone.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.CategoryName</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Trainer</dt>
                        <dd class="col-sm-8">@Model.TrainerName</dd>

                        <dt class="col-sm-4">Start time</dt>
                        <dd class="col-sm-8">@Model.StartTime.ToString("dd MMM yyyy, HH:mm")</dd>

                        <dt class="col-sm-4">End time</dt>
                        <dd class="col-sm-8">@Model.EndTime.ToString("dd MMM yyyy, HH:mm")</dd>

                        <dt class="col-sm-4">Bookings</dt>
                        <dd class="col-sm-8">@Model.CountBooking / @Model.Capacity</dd>
                    </dl>
                </div>

                <div class="card-footer bg-white border-0 p-4">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline flex-fill">Cancel</a>
                        <button type="submit" class="btn btn-danger flex-fill">Delete Session</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
