@model IReadOnlyList<Gym.Presentation.ViewModels.Sessions.SessionListItemViewModel>

<div class="container">
    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">Training Sessions</h2>
            <p class="text-muted">Manage gym training sessions and classes</p>
        </div>
        <a asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-4 py-3">
            <i class="bi bi-plus-lg me-2"></i>Add Session
        </a>
    </header>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <div class="card-header text-white py-3 @(session.Status == "Ongoing" ? "bg-success" : session.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>@session.CategoryName</h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>
                            <p><strong>Trainer:</strong> @session.TrainerName</p>
                            <p><strong>Date:</strong> @session.DateDisplay</p>
                            <p><strong>Time:</strong> @session.TimeRangeDisplay</p>
                            <p><strong>Duration:</strong> @session.Duration</p>
                            <p><strong>Capacity:</strong> @session.AvailableSlots/@session.Capacity slots</p>
                        </div>
                        <div class="card-footer bg-white border-0 d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-outline btn-sm">View Details</a>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@session.Id" class="btn btn-outline btn-sm flex-fill">Edit</a>
                                <a asp-action="Delete" asp-route-id="@session.Id" class="btn btn-outline text-danger btn-sm flex-fill">Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Sessions Available</h4>
            <p class="text-muted">Create your first training session to get started</p>
        </div>
    }
</div>
